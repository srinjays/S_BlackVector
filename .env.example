# Netra 1.0 — Environment Variables
# Copy this file to .env and fill in your values

# Gemini API (required for hybrid VQA/caption synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider Config
SATQUERY_LLM_PROVIDER=gemini
SATQUERY_LLM_MODEL=gemini-3.5-flash

# Service URLs (set automatically by run_satquery.ps1)
# SATQUERY_B2_BASE_URL=http://localhost:8100
# SATQUERY_ML_BASE_URL=http://localhost:8200
# SATQUERY_CONFIDENCE_BASE_URL=http://localhost:8100
